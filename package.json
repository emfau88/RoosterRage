{
  "name": "rooster-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:standalone": "vite build --mode standalone",
    "build:pages": "vite build --mode pages",
    "build:release": "vite build --mode release",
    "package:kongregate": "npm run test:release && node scripts/package-kongregate.mjs",
    "build:character-lab": "vite build --config vite.character-lab.config.js",
    "test:character-lab": "node --test tests/ace-prototype.test.mjs tests/ace-four-direction.test.mjs tests/ace-gameplay-pose.test.mjs tests/next-roosters-four-direction.test.mjs tests/gameplay-roosters-pose.test.mjs tests/final-roosters-pose.test.mjs tests/ace-mascot-pose.test.mjs tests/storm-mascot-pose.test.mjs tests/artillery-mascot-pose.test.mjs",
    "assets:ace-mascot": "python scripts/prepare-ace-mascot.py && node scripts/export-ace-mascot.mjs && python scripts/render-ace-mascot.py",
    "qa:ace-mascot": "node scripts/capture-ace-mascot.mjs && node docs/qa/ace-mascot-v1/render-gallery.mjs",
    "assets:ace-preview": "python scripts/prepare-ace-four-direction.py && node scripts/export-ace-four-direction.mjs && python scripts/render-ace-four-direction.py",
    "assets:ace-gameplay": "node scripts/export-ace-gameplay.mjs && python scripts/render-ace-gameplay.py",
    "assets:gameplay-roosters": "python scripts/prepare-gameplay-rooster-parts.py && node scripts/export-gameplay-roosters.mjs && python scripts/render-gameplay-roosters.py && python scripts/render-gameplay-rooster-contact-sheets.py",
    "assets:final-roosters": "python scripts/prepare-final-rooster-parts.py && node scripts/export-final-rooster-masters.mjs && node scripts/export-final-roosters.mjs && python scripts/render-final-rooster-masters.py && python scripts/render-final-roosters.py",
    "qa:final-roosters": "node scripts/capture-final-roosters.mjs && python scripts/render-final-rooster-acceptance.py",
    "assets:artillery-preview": "python scripts/prepare-artillery-four-direction.py && node scripts/export-artillery-four-direction.mjs && python scripts/render-artillery-four-direction.py",
    "assets:storm-preview": "python scripts/prepare-storm-four-direction.py && node scripts/export-storm-four-direction.mjs && python scripts/render-storm-four-direction.py",
    "assets:next-roosters": "npm run assets:ace-preview && npm run assets:artillery-preview && npm run assets:storm-preview",
    "assets:optimize": "python scripts/optimize-assets.py",
    "assets:check": "node scripts/check-assets.mjs",
    "maps:capture-previews": "node scripts/capture-arena-previews.mjs",
    "pretest:production": "npm run build",
    "test:production": "node tests/production-gate.mjs",
    "test:release": "node --test tests/public-rooster-preview.test.mjs tests/kongregate.test.mjs tests/rooster-cosmetics.test.mjs && npm run build:release && node tests/release-gate.mjs",
    "test:pages": "npm run build:pages && node tests/release-gate.mjs dist-pages /RoosterRage/ --marketing",
    "test:smoke": "node tests/rooster-smoke.mjs",
    "test:audio": "node tests/audio-settings-runner.mjs",
    "test:pickup-contact": "node tests/pickup-contact-runner.mjs",
    "test:pickup-diagnostics": "node tests/pickup-diagnostics-runner.mjs",
    "test:pickup-streaming": "node scripts/diagnose-pickup-streaming.mjs --expect-fixed",
    "test:pickup-ground-contact": "node tests/pickup-ground-contact-runner.mjs",
    "test:pickup-body-contact": "node tests/pickup-body-contact-runner.mjs",
    "test:pickup-sequence": "node tests/pickup-sequence-runner.mjs",
    "test:pickup-spawn-frame": "node tests/pickup-spawn-frame-runner.mjs",
    "test:pickup-beacons": "node tests/pickup-indicators-runner.mjs && node tests/pickup-beacons-runner.mjs",
    "test:kongregate": "node --test tests/kongregate.test.mjs",
    "test:portal-feedback-unit": "node --test tests/portal-audio-priority.test.mjs tests/portal-prop-feedback.test.mjs",
    "qa:portal-feedback": "node scripts/capture-portal-feedback.mjs && python scripts/render-portal-feedback-gallery.py",
    "assets:portrait-backdrops": "python scripts/prepare-portrait-backdrops.py",
    "qa:portrait-backdrops": "node scripts/capture-portrait-backdrops.mjs && python scripts/render-portrait-backdrops.py",
    "assets:portal-elites": "python scripts/prepare-portal-elites.py",
    "qa:portal-elites": "node scripts/capture-portal-elites.mjs && python scripts/render-portal-elites.py",
    "test:portal-elites": "node tests/portal-elites-runner.mjs",
    "assets:enemy-auras": "node scripts/prepare-enemy-auras.mjs",
    "test:enemy-auras": "node tests/enemy-auras-runner.mjs",
    "test:elite-balance": "node tests/elite-balance-runner.mjs",
    "test:bomb-confetti": "node tests/bomb-confetti-runner.mjs",
    "test:pause": "node tests/pause-runner.mjs",
    "test:menus": "node tests/responsive-menu-runner.mjs",
    "test:mechanics": "node tests/mechanics-runner.mjs",
    "test:foundation": "node tests/foundation-runner.mjs",
    "test:spawn-targeting": "node tests/spawn-targeting-runner.mjs",
    "test:adaptive-spawns": "node tests/adaptive-spawn-runner.mjs",
    "test:phase-4-identity": "node tests/phase-4-identity-runner.mjs",
    "test:pacing": "node tests/pacing-runner.mjs",
    "test:early-pacing": "node tests/early-pacing-runner.mjs",
    "test:boss": "node tests/boss-runner.mjs",
    "test:boss-matrix": "node tests/boss-build-matrix-runner.mjs",
    "test:evolution": "node tests/evolution-runner.mjs",
    "test:weapon-progression": "node tests/weapon-progression-runner.mjs",
    "test:arena": "node tests/arena-runner.mjs",
    "test:map-streaming": "node tests/map-streaming-runner.mjs",
    "test:encounter": "node tests/encounter-runner.mjs",
    "test:pressure": "node tests/pressure-runner.mjs",
    "test:hud-report": "node tests/hud-report-runner.mjs",
    "test:rooster-depth": "node tests/rooster-depth-runner.mjs",
    "test:meta": "node tests/meta-runner.mjs",
    "test:product": "node tests/product-analytics-runner.mjs",
    "test:acceptance": "node tests/acceptance-runner.mjs --matrix",
    "test:telegraphs": "node tests/acceptance-runner.mjs --telegraphs",
    "test:soak": "node tests/acceptance-runner.mjs --soak",
    "test:balance": "node tests/balance-runner.mjs",
    "test:late-run": "node tests/late-run-production-runner.mjs",
    "marketing:capture": "node scripts/capture-store-assets.mjs --screenshots",
    "marketing:readme": "node scripts/capture-store-assets.mjs --readme",
    "marketing:trailer": "node scripts/capture-store-assets.mjs --trailer",
    "assets:storm-mascot": "python scripts/prepare-storm-mascot.py && node scripts/export-storm-mascot.mjs && python scripts/render-storm-mascot.py",
    "qa:storm-mascot": "node scripts/capture-storm-mascot.mjs && node docs/qa/storm-mascot-v1/render-gallery.mjs && node scripts/build-storm-comparison.mjs",
    "assets:artillery-mascot": "python scripts/prepare-artillery-mascot.py && node scripts/export-artillery-mascot.mjs && python scripts/render-artillery-mascot.py",
    "qa:artillery-mascot": "node scripts/capture-artillery-mascot.mjs && node docs/qa/artillery-mascot-v1/render-gallery.mjs && node scripts/build-artillery-comparison.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.0.0"
  }
}
